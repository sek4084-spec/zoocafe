{
  "manifest_version": 3,
  "name": "주카페 멍사자 도우미",
  "version": "0.1.6",
  "description": "어느 웹사이트에서든 멍사자와 대화하고 네이버 검색과 주카페 친구 채팅을 이용합니다.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}],
  "web_accessible_resources": [{"resources": ["assets/cafe-portrait.png"], "matches": ["http://*/*", "https://*/*"]}]
}
